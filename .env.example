# Copy to .env. Expo inlines EXPO_PUBLIC_* into the app bundle, so nothing
# secret goes here; keys for third parties are issued per environment and
# are public by design.

# Guest API (menu, stores, orders, loyalty)
EXPO_PUBLIC_API_BASE_URL=https://api.copperpotbowls.example

# Which environment the bundle talks to: development | staging | production
EXPO_PUBLIC_ENV=development

# Map tiles for the store picker (public, per-environment key)
EXPO_PUBLIC_MAPS_KEY=replace-me

# Push: the sender id registered with the push gateway for this environment
EXPO_PUBLIC_PUSH_SENDER_ID=replace-me

# Guest-facing support line shown on the account screen
EXPO_PUBLIC_SUPPORT_PHONE=555-0100
